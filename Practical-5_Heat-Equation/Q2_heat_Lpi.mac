kill(all);
k:1;
L:%pi;
f(x):=x;
a(n):=(2/L)*integrate(f(a)*sin(n*%pi*a/L),a,0,L);
a(n);
u(x,t):=sum(a(n)*exp((-(n*%pi/L)^2)*k*t)*sin(n*%pi*x/L), n, 1, 10);
load(draw);
wxdraw2d(explicit(u(x,0),x,0,%pi),title="Heat at t=0");
wxdraw2d(explicit(u(x,0.1),x,0,%pi),title="Heat at t=0.1");
wxdraw2d(explicit(u(x,0.2),x,0,%pi),title="Heat at t=0.2");
wxdraw2d(explicit(u(x,0.3),x,0,%pi),title="Heat at t=0.3");
wxplot3d(u(x,t),[x,0,%pi],[t,0,8]);
