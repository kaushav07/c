kill(all);
eq1:'diff(y,x)=-1;
ode2(eq1,y,x);
gsol1:solve(y=c1-x,c1);
eq2:'diff(u,x)=1;
ode2(eq2,u,x);
gsol2:solve(u=x+c2,c2);
phii:rhs(first(gsol1));
shii:rhs(first(gsol2));
c1:1; c2:3;
char:solve([x(t)+y(t)-c1=0, u(t)-x(t)-c2=0, u(t)=t],[x(t),y(t),u(t)]);
define(ccx(t),rhs(first(first(char))));
define(ccy(t),rhs(second(first(char))));
define(ccz(t),rhs(third(first(char))));
wxdraw3d(parametric_surface(t, 1-t, s, t, -25, 25, s, -25, 25),
    color=cyan, parametric_surface(t, s, 3+t, t, -25, 25, s, -25, 25),
    color=black, line_width=5, parametric(ccx(t), ccy(t), ccz(t), t, -24, 24));
