kill(all);
u(x,t):=if(x>c*t) then (1/2)*(f(x+c*t)+f(x-c*t))+(1/(2*c))*integrate(g(a),a,x-c*t,x+c*t)
    else if (x<c*t) then (1/2)*(f(x+c*t)+f(c*t-x))+(1/(2*c))*integrate(g(a),a,c*t-x,x+c*t);
c:3;
f(x):=x^4;
g(x):=0;
u(x,t);
u(7,9);
load(draw)$
wxdraw2d(explicit(u(x,0),x,0,2),title="Wave at t=0");
wxdraw2d(explicit(u(x,1),x,0,2),title="Wave at t=1");
wxdraw2d(explicit(u(x,2),x,0,2),title="Wave at t=2");
